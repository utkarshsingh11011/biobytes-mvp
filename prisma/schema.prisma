generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          String    @default("PATIENT") // PATIENT, DOCTOR, ADMIN, LAB_PARTNER
  createdAt     DateTime  @default(now())

  // Relations
  reports       Report[]  @relation("PatientReports")
  alerts        HealthAlert[]
  accessCodes   DoctorAccessCode[]
  bookings      LabBooking[]
  doctorProfile DoctorProfile?
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String
  specialization  String?
}

model Report {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation("PatientReports", fields: [patientId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  status      String   @default("UPLOADED") // UPLOADED, PROCESSING, PARSED, FAILED
  rawText     String?
  parsedJson  String?
  reportDate  DateTime?
  labName     String?
  createdAt   DateTime @default(now())

  metrics     ExtractedMetric[]
}

model BiomarkerDefinition {
  id          String   @id @default(uuid())
  code        String   @unique // canonical code e.g. HEMOGLOBIN
  displayName String
  unit        String
  refMin      Float?
  refMax      Float?
  category    String?

  metrics     ExtractedMetric[]
}

model ExtractedMetric {
  id              String              @id @default(uuid())
  reportId        String
  report          Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  biomarkerId     String
  biomarker       BiomarkerDefinition @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)
  value           Float
  unit            String
  refMin          Float?
  refMax          Float?
  isAbnormal      Boolean             @default(false)
  createdAt       DateTime            @default(now())
}

model DoctorAccessCode {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code        String   @unique
  expiresAt   DateTime
  maxUses     Int      @default(5)
  usedCount   Int      @default(0)
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())

  usages      AccessCodeUsage[]
}

model AccessCodeUsage {
  id          String           @id @default(uuid())
  codeId      String
  code        DoctorAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  accessedAt  DateTime         @default(now())
  ipAddress   String?
}

model HealthAlert {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metricId    String?  // Optional reference to ExtractedMetric if we want a hard link
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LabPartner {
  id            String   @id @default(uuid())
  name          String
  logoUrl       String?
  bookingUrl    String?
  commissionPct Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  bookings      LabBooking[]
}

model LabBooking {
  id          String     @id @default(uuid())
  patientId   String
  patient     User       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labId       String
  lab         LabPartner @relation(fields: [labId], references: [id], onDelete: Cascade)
  status      String     @default("PENDING") // PENDING, CONFIRMED, COMPLETED
  createdAt   DateTime   @default(now())
}
